#!/bin/sh
#
# Writes the final sources.list file
#

CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")
RELEASE="trixie"

cat << EOF > $CHROOT/etc/apt/sources.list
# See https://wiki.debian.org/SourcesList for more information.
deb https://mirrors.ustc.edu.cn/debian $RELEASE main non-free-firmware
deb-src https://mirrors.ustc.edu.cn/debian $RELEASE main non-free-firmware

deb https://mirrors.ustc.edu.cn/debian $RELEASE-updates main non-free-firmware
deb-src https://mirrors.ustc.edu.cn/debian $RELEASE-updates main non-free-firmware

deb https://mirrors.ustc.edu.cn/debian-security/ $RELEASE-security main non-free-firmware
deb-src https://mirrors.ustc.edu.cn/debian-security/ $RELEASE-security main non-free-firmware

# Backports allow you to install newer versions of software made available for this release
deb https://mirrors.ustc.edu.cn/debian $RELEASE-backports main non-free-firmware
deb-src https://mirrors.ustc.edu.cn/debian $RELEASE-backports main non-free-firmware
EOF

exit 0
