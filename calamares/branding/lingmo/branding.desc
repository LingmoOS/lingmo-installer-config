---
# Lingmo OS 品牌配置（Calamares 3.3.x）
# 键结构对齐 Calamares 上游 src/branding/default/branding.desc：
# componentName / welcomeStyleCalamares / welcomeExpandingLogo / windowExpanding /
# windowSize / windowPlacement / sidebar / navigation / strings / images / style /
# slideshow / slideshowAPI。新增或删除顶层键前请先与上游比对，缺键会导致启动即退出。
componentName:   lingmo

welcomeStyleCalamares:   false
welcomeExpandingLogo:    true

windowExpanding:   normal
windowSize:        800px,520px
windowPlacement:   center

sidebar:    widget
navigation: widget

strings:
    productName:         Lingmo OS
    shortProductName:    Lingmo
    version:             5.0
    shortVersion:        5.0
    versionedName:       Lingmo 5.0
    shortVersionedName:  Lingmo 5.0
    bootloaderEntryName: Lingmo OS
    productUrl:          https://lingmo.org
    supportUrl:          https://github.com/orgs/LingmoOS/discussions
    knownIssuesUrl:      https://github.com/orgs/LingmoOS/discussions
    releaseNotesUrl:     https://lingmo.org
    donateUrl:           https://lingmo.org/zh-cn/donate

images:
    productIcon:         "logo.png"
    productLogo:         "logo.png"
    productWelcome:      "welcome.png"

style:
    SidebarBackground:        "#292F34"
    SidebarText:              "#FFFFFF"
    SidebarTextCurrent:       "#292F34"
    SidebarBackgroundCurrent: "#D35400"

slideshow:               "show.qml"
slideshowAPI: 2
