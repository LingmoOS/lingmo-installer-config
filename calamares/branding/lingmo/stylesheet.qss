/*
 * Lingmo OS Calamares branding stylesheet
 * Matches LingmoSDK Button visual language: rounded rect, accent blue primary,
 * subtle secondary, consistent spacing and typography.
 *
 * SPDX-License-Identifier: GPL-3.0-or-later
 */

/* ─── Global ─────────────────────────────────────────────────────────────── */

QWidget {
    font-family: "Noto Sans", "Source Han Sans SC", sans-serif;
    font-size: 10pt;
    color: #1a1a1a;
}

QDialog, #mainApp {
    background: #f5f5f7;
}

/* Dark mode follows the platform theme plugin's palette; the QSS below is
 * written to use palette roles so both modes look right without duplication. */

/* ─── Main window card ───────────────────────────────────────────────────── */

#mainApp {
    background: palette(window);
    border-radius: 14px;
}

/* ─── Buttons — matching LingmoSDK Button ────────────────────────────────── */
/*
 * LingmoSDK Button visual spec:
 *   - Rounded rect, mediumRadius = 10px
 *   - Min size: 64×32
 *   - Padding: largeSpacing = 12px horizontal
 *   - Primary: accent fill (#3385FF), white text
 *   - Secondary: subtle background, theme text color
 *   - Hover: lighter; Pressed: darker
 *   - Focus: 1px accent ring
 */

QPushButton {
    border: none;
    border-radius: 10px;
    padding: 6px 20px;
    min-height: 32px;
    min-width: 64px;
    font-weight: 500;
    background: palette(button);
    color: palette(button-text);
}

QPushButton:hover {
    background: palette(midlight);
}

QPushButton:pressed {
    background: palette(dark);
}

QPushButton:disabled {
    color: palette(disabled, window-text);
    background: palette(window);
}

/* Focus ring — LingmoSDK draws a 1px accent border on focused buttons */
QPushButton:focus {
    outline: none;
}

/* ─── Primary action button (Next / Install) ─────────────────────────────── */
/*
 * The "Next" button is the primary action, matching LingmoSDK's accent Button.
 * Accent blue: #3385FF (LingmoOS default accent::blue)
 */

#view-button-next {
    background: #3385FF;
    color: #ffffff;
    font-weight: 600;
}

#view-button-next:hover {
    background: #2972e0;
}

#view-button-next:pressed {
    background: #2560c4;
}

#view-button-next:disabled {
    background: #a0c4ff;
    color: #f0f0f0;
}

/* ─── Secondary buttons (Back, Cancel) ───────────────────────────────────── */
/*
 * Secondary buttons use a quiet background, matching LingmoSDK's default Button.
 */

#view-button-back,
#view-button-cancel {
    background: palette(button);
    color: palette(button-text);
}

#view-button-back:hover,
#view-button-cancel:hover {
    background: palette(midlight);
}

#view-button-back:pressed,
#view-button-cancel:pressed {
    background: palette(dark);
}

#view-button-back:disabled,
#view-button-cancel:disabled {
    color: palette(disabled, window-text);
    background: palette(window);
}

/* ─── Sidebar buttons (About, Debug) ─────────────────────────────────────── */

#aboutButton,
#debugButton {
    background: transparent;
    color: palette(window-text);
    border-radius: 8px;
    padding: 4px 12px;
    min-height: 28px;
    font-size: 9pt;
}

#aboutButton:hover,
#debugButton:hover {
    background: rgba(255, 255, 255, 26);  /* 10% white */
}

#aboutButton:pressed,
#debugButton:pressed {
    background: rgba(255, 255, 255, 40);
}

/* ─── Sidebar ────────────────────────────────────────────────────────────── */

#sidebarApp {
    background: #292F34;
    color: #ffffff;
    border-top-left-radius: 14px;
    border-bottom-left-radius: 14px;
}

#logoApp {
    background: transparent;
}

/* ─── Progress tree (sidebar step list) ───────────────────────────────────── */

ProgressTreeView {
    background: transparent;
    color: rgba(255, 255, 255, 200);
    border: none;
    outline: none;
}

ProgressTreeView::item {
    padding: 6px 8px;
    border-radius: 8px;
}

ProgressTreeView::item:selected {
    background: #3385FF;
    color: #ffffff;
    border-radius: 8px;
}

/* ─── Scroll areas ───────────────────────────────────────────────────────── */

QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 0;
}

QScrollBar::handle:vertical {
    background: palette(mid);
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: palette(dark);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 4px;
}

QScrollBar::handle:horizontal {
    background: palette(mid);
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: palette(dark);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* ─── Input widgets ──────────────────────────────────────────────────────── */
/*
 * LingmoSDK TextField visual spec:
 *   - Border: 1px palette(mid), becomes 1px #3385FF on focus
 *   - Radius: bigRadius = 12px
 *   - Padding: 6px vertical, 12px horizontal
 *   - Min-height: 36px (SDK's editable_text default)
 *   - Placeholder: disabledText opacity
 *   - Selection: accent fill
 */

QLineEdit,
QPlainTextEdit,
QTextEdit {
    background: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 36px;
    selection-background-color: #3385FF;
    selection-color: #ffffff;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border: 1.5px solid #3385FF;
    background: palette(base);
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled {
    background: palette(window);
    color: palette(disabled, text);
    border-color: palette(window);
}

/* Placeholder text color — darker on light, lighter on dark */
QLineEdit[placeholderText] {
    color: palette(placeholder-text);
}

/* ─── ComboBox ────────────────────────────────────────────────────────────── */

QComboBox {
    background: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 36px;
    selection-background-color: #3385FF;
    selection-color: #ffffff;
}

QComboBox:focus {
    border: 1.5px solid #3385FF;
}

QComboBox:disabled {
    background: palette(window);
    color: palette(disabled, text);
    border-color: palette(window);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 28px;
    border: none;
    border-left: 1px solid palette(mid);
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTYiIGhlaWdodD0iMTYiIHZpZXdCb3g9IjAgMCAxNiAxNiIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNNCw2IGw0LDQgbDQsLTQiIGZpbGw9Im5vbmUiIHN0cm9rZT0iIzY2NiIgc3Ryb2tlLXdpZHRoPSIxLjUiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCIvPjwvc3ZnPg==);
    width: 12px;
    height: 12px;
}

/* Drop-down popup list */
QComboBox QAbstractItemView {
    background: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 10px;
    padding: 4px;
    outline: none;
    selection-background-color: #3385FF;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 6px;
    min-height: 32px;
}

QComboBox QAbstractItemView::item:hover {
    background: rgba(51, 133, 255, 0.12);
}

QComboBox QAbstractItemView::item:selected {
    background: #3385FF;
    color: #ffffff;
}

/* ─── SpinBox ─────────────────────────────────────────────────────────────── */

QSpinBox,
QDoubleSpinBox {
    background: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 8px;
    padding: 6px 6px 6px 12px;
    min-height: 36px;
    selection-background-color: #3385FF;
    selection-color: #ffffff;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1.5px solid #3385FF;
}

QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background: palette(window);
    color: palette(disabled, text);
    border-color: palette(window);
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    border: none;
    width: 22px;
    border-bottom: 1px solid palette(mid);
    border-top-right-radius: 8px;
    background: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    border: none;
    width: 22px;
    border-bottom-right-radius: 8px;
    background: transparent;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background: rgba(51, 133, 255, 0.10);
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 8px; height: 8px;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTYiIGhlaWdodD0iMTYiIHZpZXdCb3g9IjAgMCAxNiAxNiIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNNCwxMCBsNCwtNCBsNCw0IiBmaWxsPSJub25lIiBzdHJva2U9IiM2NjYiIHN0cm9rZS13aWR0aD0iMS41IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=);
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 8px; height: 8px;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTYiIGhlaWdodD0iMTYiIHZpZXdCb3g9IjAgMCAxNiAxNiIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNNCw2IGw0LDQgbDQsLTQiIGZpbGw9Im5vbmUiIHN0cm9rZT0iIzY2NiIgc3Ryb2tlLXdpZHRoPSIxLjUiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCIvPjwvc3ZnPg==);
}

/* ─── Progress bar — exec-progress (installation step) ───────────────────── */
/*
 * LingmoSDK ProgressBar visual spec:
 *   - Height: 6px (track) — matches SDK kBarHeight
 *   - Track: disabledText.withAlpha(0.12) rounded pill
 *   - Fill: accent #3385FF, animated (indeterminate uses pulsing chunk)
 *   - Radius: half height → full pill = 3px
 *   - Text: hidden (percentage shown externally)
 */

QProgressBar {
    background: transparent;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
    text-align: center;
    color: transparent;       /* hide "%" text inside the bar */
}

QProgressBar::chunk {
    background: #3385FF;
    border-radius: 3px;
}

/* Installation-step progress bar — slightly taller for visibility */
#exec-progress {
    background: rgba(0, 0, 0, 0.08);
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
    color: transparent;
}

#exec-progress::chunk {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #3385FF,
        stop: 1 #5ba0ff
    );
    border-radius: 4px;
}

/* Progress bar for partition / other pages */
QProgressBar[orientation="horizontal"] {
    background: rgba(0, 0, 0, 0.08);
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
    color: transparent;
}

QProgressBar[orientation="horizontal"]::chunk {
    background: #3385FF;
    border-radius: 3px;
}

/* ─── Checkboxes and radio buttons ────────────────────────────────────────── */

QCheckBox, QRadioButton {
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid palette(mid);
    background: transparent;
}

QCheckBox::indicator {
    border-radius: 5px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #3385FF;
    border-color: #3385FF;
}

QCheckBox::indicator:checked {
    /* Checkmark via image would need a resource; use border trick */
    background: #3385FF;
    border-color: #3385FF;
}

/* ─── Group boxes ─────────────────────────────────────────────────────────── */

QGroupBox {
    border: 1px solid palette(mid);
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
}

/* ─── Labels ─────────────────────────────────────────────────────────────── */

QLabel {
    background: transparent;
}

/* ─── Welcome page buttons ───────────────────────────────────────────────── */

#donateButton,
#supportButton,
#releaseNotesButton,
#knownIssuesButton,
#aboutButton {
    background: palette(button);
    color: palette(button-text);
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 28px;
}

#donateButton:hover,
#supportButton:hover,
#releaseNotesButton:hover,
#knownIssuesButton:hover {
    background: palette(midlight);
}
